# Copy this file to .env and edit. The app reads it at start-up, so restart the app after changing it.

# true  -> also compute COMET with the Hugging Face model (needs the Python 3.12 environment from
#          setup_model_env.bat; the model is downloaded the first time, a few GB)
# false -> COMET is skipped; BLEU and chrF++ are still computed
USE_MODEL=false

# COMET model named in the RFP clarification
COMET_MODEL=Unbabel/wmt22-comet-da

# Optional: path to an already downloaded .ckpt file. Leave empty to use COMET_MODEL.
COMET_CHECKPOINT=

# Same batch size for every vendor (RFP requirement)
COMET_BATCH_SIZE=16

# 0 = CPU, 1 = one GPU
COMET_GPUS=0
